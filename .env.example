# ==============================================================================
# FINSCOPE SAAS ENVIRONMENT VARIABLES
# Copy this file to .env or configure in Netlify / Cloud Run dashboard.
# DO NOT COMMIT REAL SECRETS OR SERVICE ROLE KEYS TO VERSION CONTROL.
# ==============================================================================

# 1. Gemini AI API Key (Server-Side Only)
# Used for senior consultant executive narratives, document extraction, and chat
GEMINI_API_KEY="your-gemini-api-key-here"

# 2. Host Application URL
# Used for OAuth redirects and CORS policy
APP_URL="http://localhost:3000"

# 3. Supabase Cloud Configuration (Client-Safe Publishable Anon Keys)
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key-here"

# 4. Optional Storage & Production Settings
# VITE_APP_ENV="production"
